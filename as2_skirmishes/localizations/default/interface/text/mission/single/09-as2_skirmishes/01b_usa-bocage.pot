msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/mission_prepare_player"
msgid "Prepare to repel the enemy assault!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/mission_defend_hq"
msgid "Defend our field HQ  at all costs!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/mission_survive"
msgid "Maintain a defensive presence, survive and eliminate the majority of enemy units!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/mission_convoy"
msgid "Repair  and recover a powerful allied tank disabled during an ambush on an allied convoy!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/name"
msgid "[USA] Bocage"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/name_big"
msgid "Bocage"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_money"
msgid "Good job, you survived another enemy attack wave! HQ grants you additional resources. Use them wisely and prepare for the next enemy attack wave!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_finish"
msgid "Enemy attack waves are over! To ensure victory eliminate the majority of enemy forces that are still on the battlefield!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_start"
msgid "Major, today we have a huge task ahead of us. Your objective is to defend the outskirts of Bocage from a German armored counter offensive!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_start2"
msgid "Our field HQ must remain ours at all costs. The more enemy attack waves we survive, the more reinforcements HQ will grant us."
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_start_attack"
msgid "Major! I have received reports from forward observers claiming there is a major enemy armor column ahead. It seems like the assault is starting, prepare yourself to defend!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_counter1"
msgid "Major! Stronger enemy forces than expected have been spotted!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_counter2"
msgid "Alarm! Reports are coming that heavy enemy units are approaching!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_counter3"
msgid "Brace yourself! Enemy is throwing their best units at us in their final push!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_convoy"
msgid "Enemy intercepted our convoy not far from our location. This convoy contains a special tank. We should try and recover this tank to ensure victory!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_convoyfail"
msgid "The enemy managed to destroy the special tank from the allied convoy!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_convoyassign"
msgid "Any allied convoy survivors are now under your command!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/officer_convoycomplete"
msgid "Excellent job! You've repaired and recovered the special tank lost during an attack on our allied convoy. Now use it to defend your position!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/hint_start_attack"
msgid "Make sure you have positioned yourself well and picked up the right tools to take out vast amounts of enemy armor!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/hint_direction"
msgid "HQ indicates that enemy forces will be attacking from the North!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/hint_nomedic"
msgid "Be Careful. In this mission medics are not available. When your soldiers get severely wounded, they cannot be revived."
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/hint_resources"
msgid "Expect to be outnumbered and outgunned. Think of saving resources if possible. Try to steal enemy weapons as well as repair enemy tanks!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/outro_completed"
msgid "Great job! You've made Uncle Sam proud!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/outro_failed"
msgid "You have been defeated!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/kill_majority"
msgid "Kill the majority of enemy forces to earn Victory!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/01b_usa-bocage/outro_start"
msgid ""
msgstr ""

