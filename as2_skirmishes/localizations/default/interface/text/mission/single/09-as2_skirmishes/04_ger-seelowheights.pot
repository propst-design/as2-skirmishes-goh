msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/name"
msgid "[Germany] Seelow Heights"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/name_big"
msgid "Seelow Heights"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_10min"
msgid "We are holding out! Continue and our reinforcements will arrive soon!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_20min"
msgid "Reports indicate our reinforcements are on the way. Keep it up, we have to defend our position at all costs!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_25min"
msgid "Our reinforcements are almost here. Don’t give up! We must smash our enemies... for the Fatherland!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_lostflag_1"
msgid "We can’t hold, we are losing our forward outpost. We request reinforcements!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_lostflag_2"
msgid "We are losing ground. Russians have overrun another forward position! We can’t keep this up... we must stop them!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_lostflag_3"
msgid "Retreat! They have taken all forward positions, we must fall back to our field HQ!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_lostflag_recapture"
msgid "Excellent counter-attack! All strategic positions have been recaptured! You are a tactical genius!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_start"
msgid "Herr Oberstleutnant, thank goodness you’ve arrived... The Red Army is preparing for a major assault on Berlin. Command has granted limited resources, but we must defend our position at all costs!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_start2"
msgid "Our defense sector is split into four strategic points. We can afford to lose some of them, but the field HQ must remain ours at all costs. The longer we hold out the more reinforcements HQ will grant us. Our armored divisions are already moving in and we are promised a swift counter-attack if we hold out!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/officer_start_attack"
msgid "Herr Oberstleutnant! Forward observers report a major enemy movement ahead. The assault has begun, so prepare yourself to defend Seelow Heights. The gates to Berlin cannot fall... for the Fatherland!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/outro_completed"
msgid "Excellent job! You've made the Fatherland proud!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/outro_failed"
msgid "You have been defeated!"
msgstr ""

msgctxt "mission/single/09-as2_skirmishes/04_ger-seelowheights/outro_start"
msgid ""
msgstr ""

